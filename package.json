{
  "name": "comboo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run assets && esbuild src/main.ts --bundle --minify --target=es2020 --outfile=dist/game.js",
    "build:single": "npm run build && node scripts/inline.mjs",
    "test": "npm run assets && tsx --test tests/*.test.ts",
    "typecheck": "npm run assets && tsc --noEmit",
    "assets:list": "node scripts/list-assets.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "sim": "tsx scripts/sim.ts"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
